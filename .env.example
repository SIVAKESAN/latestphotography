# ============================================================
# LATEST PHOTOGRAPHY — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local or any file containing real secrets.
# ============================================================

# Supabase (required when connecting to a real Supabase project)
# Get these from: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================================
# Admin Authentication
# ============================================================
# The admin portal at /admin uses client-side localStorage auth.
# When integrating Supabase Auth, set real credentials via your
# Supabase project dashboard — never commit passwords here.
# Demo admin access: use your own email + any password >= 6 chars.
# ============================================================
